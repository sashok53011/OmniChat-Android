menu "Wi-Fi Remote (fixed config)"
    config WIFI_RMT_STATIC_RX_BUFFER_NUM # ignore: multiple-definition
        int "Max number of WiFi static RX buffers"
        default 10
    config WIFI_RMT_DYNAMIC_RX_BUFFER_NUM # ignore: multiple-definition
        int "Max number of WiFi dynamic RX buffers"
        default 32
    choice WIFI_RMT_TX_BUFFER # ignore: multiple-definition
        prompt "Type of WiFi TX buffers"
        default WIFI_RMT_DYNAMIC_TX_BUFFER
        config WIFI_RMT_STATIC_TX_BUFFER # ignore: multiple-definition
            bool "Static"
        config WIFI_RMT_DYNAMIC_TX_BUFFER # ignore: multiple-definition
            bool "Dynamic"
    endchoice
    config WIFI_RMT_TX_BUFFER_TYPE # ignore: multiple-definition
        int
        default 0 if WIFI_RMT_STATIC_TX_BUFFER
        default 1 if WIFI_RMT_DYNAMIC_TX_BUFFER
    config WIFI_RMT_DYNAMIC_TX_BUFFER_NUM # ignore: multiple-definition
        int "Max number of WiFi dynamic TX buffers"
        depends on WIFI_RMT_DYNAMIC_TX_BUFFER
        default 32
    config WIFI_RMT_STATIC_TX_BUFFER_NUM # ignore: multiple-definition
        int "Max number of WiFi static TX buffers"
        depends on WIFI_RMT_STATIC_TX_BUFFER
        default 10
    config WIFI_RMT_CACHE_TX_BUFFER_NUM # ignore: multiple-definition
        int "Max number of cache TX buffers"
        default 0
    config WIFI_RMT_DYNAMIC_RX_MGMT_BUF # ignore: multiple-definition
        int "RX management buffer type"
        default 16
    config WIFI_RMT_ESPNOW_MAX_ENCRYPT_NUM # ignore: multiple-definition
        int "Maximum espnow encrypt peers number"
        default 0
    config WIFI_RMT_RX_MGMT_BUF_NUM_DEF # ignore: multiple-definition
        int "Default number of RX management buffers"
        default 5
endmenu
